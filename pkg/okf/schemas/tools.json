[
  {
    "name": "okf_search",
    "description": "Search the OKF knowledge bundle for concepts by query terms, tags, and titles using in-memory BM25 scoring, or by file path via code_refs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search terms to find matching concepts."
        },
        "scope": {
          "type": "string",
          "enum": ["all", "project", "vendor", "user", "system"],
          "description": "Optional memory layer to search: all, project, vendor, user, system (default 'all')."
        },
        "for_path": {
          "type": "string",
          "description": "Optional file or directory path to find governing concepts via code_refs (e.g. 'pkg/okf/types.go')."
        },
        "filter": {
          "type": "string",
          "description": "Optional frontmatter key-value filter predicate (e.g. 'type=Decision', 'verified.by=human')."
        },
        "stale_within": {
          "type": "string",
          "description": "Optional relative duration to filter concepts becoming stale within horizon (e.g. '14d', '2w', '3m')."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (default 10)."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "description": "Ranked matches envelope.",
      "properties": {
        "results": {
          "type": "array",
          "description": "Ranked search results.",
          "items": {
            "type": "object",
            "properties": {
              "concept_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "governance": {
                "type": "string",
                "description": "Agent authority level: constraint | hold | context."
              },
              "code_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Source paths or globs this concept governs."
              },
              "score": {
                "type": "number"
              },
              "matched_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inbound": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outbound": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string",
                "enum": ["project", "vendor", "user", "system"],
                "description": "Originating memory scope: project | vendor | user | system."
              },
              "priority": {
                "type": "integer",
                "description": "Memory layer priority: project (100) > vendor (70) > user (50) > system (10)."
              },
              "origin": {
                "type": "string",
                "description": "Source origin indicator (e.g. 'local', '@vendor-bundle', 'user', 'system')."
              }
            },
            "required": [
              "concept_id",
              "title",
              "type",
              "description",
              "score",
              "matched_on"
            ]
          }
        }
      },
      "required": [
        "results"
      ]
    }
  },
  {
    "name": "okf_show",
    "description": "Show the full content, frontmatter, and relationships of a specific concept.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "concept_id": {
          "type": "string",
          "description": "The concept ID or scoped reference. Bare IDs search project, user, then system. Explicit scopes stay exact: 'user:<id>', 'system:<id>', or a canonical URN such as 'okf://project/<id>'. Vendor concepts require '@bundle/<id>'."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": [
        "concept_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "The concept record (frontmatter fields plus body) and resolved scope.",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["project", "vendor", "user", "system"],
          "description": "Memory scope containing the returned concept."
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "stale_after": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "Markdown body after frontmatter."
        },
        "governance": {
          "type": "string",
          "description": "Agent authority level: constraint | hold | context."
        },
        "code_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source paths or globs this concept governs."
        }
      },
      "required": [
        "id",
        "path",
        "type",
        "scope"
      ]
    }
  },
  {
    "name": "okf_validate",
    "description": "Validate the entire OKF bundle for conformance, broken links, orphans, and description drift.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "strict": {
          "type": "boolean",
          "description": "Treat connectivity warnings and trust gaps as errors."
        },
        "stale": {
          "type": "boolean",
          "description": "Fail if any concepts have reached their stale_after date."
        },
        "stale_within": {
          "type": "string",
          "description": "Optional relative duration to fail if concepts expire within horizon (e.g. '14d', '2w')."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": []
    },
    "outputSchema": {
      "type": "object",
      "description": "Validation report for the bundle.",
      "properties": {
        "bundle_path": {
          "type": "string"
        },
        "declared_version": {
          "type": "string",
          "description": "OKF version declared by the bundle."
        },
        "concept_count": {
          "type": "integer"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Diagnostics from governance/code_refs gates."
        },
        "broken_links": {
          "type": "array",
          "description": "Graph integrity findings.",
          "items": {
            "type": "object",
            "properties": {
              "source_concept": {
                "type": "string"
              },
              "target_href": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "source_concept",
              "target_href",
              "reason"
            ]
          }
        },
        "orphans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale_count": {
          "type": "integer"
        },
        "is_conformant": {
          "type": "boolean"
        },
        "gate_passed": {
          "type": "boolean"
        }
      },
      "required": [
        "bundle_path",
        "concept_count",
        "errors",
        "warnings",
        "is_conformant",
        "gate_passed"
      ]
    }
  },
  {
    "name": "okf_create",
    "description": "Create a new concept with frontmatter and automatic bookkeeping (updating log.md and parent index.md).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "concept_id": {
          "type": "string",
          "description": "Path without .md (e.g. 'decisions/auth-flow')."
        },
        "type": {
          "type": "string",
          "description": "The concept type (e.g. 'Decision', 'Fact', 'Process')."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title."
        },
        "description": {
          "type": "string",
          "description": "One sentence summary of the concept."
        },
        "body": {
          "type": "string",
          "description": "Markdown body content."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "stable", "deprecated"],
          "default": "stable",
          "description": "Optional concept lifecycle status; defaults to stable."
        },
        "tags": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 50},
          "description": "Optional array of searchable tags."
        },
        "stale_after": {
          "type": "string",
          "description": "Optional review deadline: YYYY-MM-DD, ISO 8601 timestamp (normalized to UTC date), or relative duration (e.g. '14d', '2w', '3m', '90d')."
        },
        "change_note": {
          "type": "string",
          "description": "Optional brief note recorded in log.md explaining the creation."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": [
        "concept_id",
        "type",
        "title",
        "description"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "Creation confirmation and metadata.",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "concept_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "warning": {
          "type": "string",
          "description": "Optional non-fatal warning (e.g. stale_after date is in the past)."
        }
      },
      "required": [
        "success",
        "concept_id",
        "path",
        "message"
      ]
    }
  },
  {
    "name": "okf_update",
    "description": "Update an existing concept's type, status, tags, title, description, body, or stale_after with automatic log.md bookkeeping. Omitted fields are preserved; an empty tags array clears tags; empty stale_after string clears stale_after.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "concept_id": {
          "type": "string",
          "description": "Path without .md (e.g. 'decisions/auth-flow')."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Updated non-empty concept type."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "stable", "deprecated"],
          "description": "Updated concept lifecycle status."
        },
        "tags": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 50},
          "description": "Replacement tags; an empty array clears existing tags."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Updated human-readable title."
        },
        "description": {
          "type": "string",
          "description": "Updated one-sentence summary."
        },
        "body": {
          "type": "string",
          "description": "Updated markdown body content."
        },
        "stale_after": {
          "type": "string",
          "description": "Updated review deadline: YYYY-MM-DD, ISO 8601 timestamp (normalized to UTC date), relative duration (e.g. '14d', '2w', '3m', '90d'), or empty string \"\" to remove the key."
        },
        "change_note": {
          "type": "string",
          "description": "Optional brief note recorded in log.md explaining the update."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": [
        "concept_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "Update confirmation and metadata.",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "concept_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "warning": {
          "type": "string",
          "description": "Optional non-fatal warning (e.g. stale_after date is in the past)."
        }
      },
      "required": [
        "success",
        "concept_id",
        "path",
        "message"
      ]
    }
  },
  {
    "name": "okf_relate",
    "description": "Connect two concepts with a relative link and context description.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Source concept ID."
        },
        "target_id": {
          "type": "string",
          "description": "Target concept ID."
        },
        "description": {
          "type": "string",
          "description": "Context description explaining the relationship."
        },
        "change_note": {
          "type": "string",
          "description": "Optional brief note recorded in log.md explaining why the concepts were linked."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": [
        "source_id",
        "target_id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "Relationship confirmation and metadata.",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "source_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "source_id",
        "target_id",
        "message"
      ]
    }
  },
  {
    "name": "okf_changes",
    "description": "Query concepts created, updated, related, deprecated, or deleted within a time range by combining log.md history with bundle concept metadata.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "description": "Start of time range (inclusive): ISO date (YYYY-MM-DD), ISO 8601 timestamp, or relative duration (e.g. '1d', '2w', '3m', '48h')."
        },
        "until": {
          "type": "string",
          "description": "Optional end of time range (inclusive): ISO date (YYYY-MM-DD), ISO 8601 timestamp, or relative duration. Defaults to now."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of changed concepts to return (default 50, max 500)."
        },
        "bundle": {
          "type": "string",
          "description": "Optional path to the OKF knowledge bundle directory (defaults to 'knowledge' or project bundle)."
        }
      },
      "required": [
        "since"
      ]
    },
    "outputSchema": {
      "type": "object",
      "description": "Concept changes within the requested time range, sorted newest first.",
      "properties": {
        "since": {
          "type": "string",
          "description": "Resolved RFC3339 start timestamp of the query range."
        },
        "until": {
          "type": "string",
          "description": "Resolved RFC3339 end timestamp of the query range."
        },
        "total": {
          "type": "integer",
          "description": "Total number of matching concepts before applying limit."
        },
        "changes": {
          "type": "array",
          "description": "Changed concepts ordered newest first.",
          "items": {
            "type": "object",
            "properties": {
              "concept_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "deleted": {
                "type": "boolean"
              },
              "generated_at": {
                "type": "string"
              },
              "generated_by": {
                "type": "string"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "at"
                  ]
                }
              }
            },
            "required": [
              "concept_id",
              "title",
              "description",
              "operations"
            ]
          }
        }
      },
      "required": [
        "since",
        "until",
        "total",
        "changes"
      ]
    }
  }
]
